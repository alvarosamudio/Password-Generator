#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export QT_SELECT = 6

%:
	dh $@ --buildsystem=qmake6

# passwordgenerator.pro es un "subdirs" que compila la app y las pruebas
override_dh_auto_configure:
	dh_auto_configure -- $(CURDIR)/passwordgenerator.pro PREFIX=/usr

# Las pruebas crean widgets: sin pantalla, con la plataforma offscreen
override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen dh_auto_test
